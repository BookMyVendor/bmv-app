{
  "expo": {
    "name": "BMV",
    "slug": "BookMyVendors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bmv-logo-transparent.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/bmv-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bmv-logo-transparent.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/images/bmv-logo-transparent.png"
      },
      "icon": "./assets/images/bmv-logo-transparent.png",
      "navigationBar": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.bnt.bookmyvendors"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
